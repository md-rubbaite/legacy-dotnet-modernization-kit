<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="Shop" connectionString="Server=sql01;Database=Shop;User Id=shop;Password=Summer2019!;" providerName="System.Data.SqlClient" />
    <add name="Reporting" connectionString="Server=sql02;Database=Reports;Integrated Security=true;" />
    <add name="Staging" connectionString="Server=sql03;Database=Shop;User Id=shop;Password=__STAGING_PASSWORD__;" />
  </connectionStrings>
  <appSettings>
    <add key="RatesUrl" value="https://rates.example.com/usd" />
    <add key="PaymentApiKey" value="FAKE-not-a-real-key-1234" />
    <add key="SmtpPassword" value="#{SmtpPassword}" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.7.2" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" timeout="30" />
    </authentication>
    <sessionState mode="InProc" timeout="20" />
    <machineKey validationKey="FAKE0000" decryptionKey="FAKE0000" validation="HMACSHA256" />
    <httpModules>
      <add name="AuditModule" type="LegacyShop.Web.AuditModule" />
    </httpModules>
  </system.web>
</configuration>
